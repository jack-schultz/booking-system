# Copy to .env and adjust for your Supabase / PowerSync project.
# Local dev typically points at your dev stack; production and dev preview
# builds use separate repository secrets in CI (see docs/deployment.md).

# These are publishable (anon) keys, safe for client-side use.
# Using an env keeps project-specific values out of git.

# For bunny.net CI builds, add repository secrets:
#   Production (main branch): VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_POWERSYNC_URL
#   Dev preview (dev branch): VITE_SUPABASE_URL_DEV, VITE_SUPABASE_ANON_KEY_DEV, VITE_POWERSYNC_URL_DEV
#
# Bunny.net deploy also requires: BUNNY_STORAGE_ZONE_NAME, BUNNY_STORAGE_ZONE_PASSWORD,
# BUNNY_STORAGE_ENDPOINT, BUNNY_API_KEY, BUNNY_PULL_ZONE_ID - see docs/deployment.md.

VITE_SUPABASE_URL=https://your-dev-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-dev-supabase-anon-key
# PowerSync Dashboard → dev instance → Connect → copy instance URL
VITE_POWERSYNC_URL=https://your-dev-instance.powersync.journeyapps.com

# Optional: override local SQLite filename (default: bookings.db, or bookings-dev.db on dev branch / /dev/ builds)
# VITE_DB_FILENAME=bookings-dev.db
