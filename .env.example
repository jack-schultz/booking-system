# Copy to .env and adjust for your Supabase project.
# This allows developer testing with local .env file

# These are publishable (anon) keys, safe for client-side use.
# Using an env keeps project-specific values out of git.

# For GitHub Pages and bunny.net CI builds, add these as repository secrets
# (Settings → Secrets and variables → Actions → Repository secrets).
# Secret names must match exactly.
#
# Bunny.net deploy also requires: BUNNY_STORAGE_ZONE_NAME, BUNNY_STORAGE_ZONE_PASSWORD,
# BUNNY_STORAGE_ENDPOINT, BUNNY_API_KEY, BUNNY_PULL_ZONE_ID - see docs/deployment.md.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# PowerSync Dashboard → select instance → Connect → copy instance URL
VITE_POWERSYNC_URL=https://your-instance.powersync.journeyapps.com

# Shared demo sandbox account (intentionally public in the client bundle).
VITE_DEMO_EMAIL=demo@example.com
VITE_DEMO_PASSWORD=your-demo-password
